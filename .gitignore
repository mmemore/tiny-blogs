# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
/build/
dist-next/
dist-prev/
*.tsbuildinfo

# Release pipeline artifacts (snapshot is public content, but session-local)
.release/

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Local runtime artifacts (uploaded images live under UPLOAD_DIR, default ./var/uploads)
var/

# Test & coverage
coverage/

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Agent workspace (session-local data, not part of the product)
.workbuddy/

# QA session artifacts (screenshots / browser session state) — session-local, not the product
qa-shots/
.playwright-cli/
_tmp_*

# One-off exploratory artifacts: prototype screens are throwaway, not the product
.scratch/**/prototype/

# Dev-process artifacts (issue tracker, agent workflow notes) stay local-only:
# the public repo shows the source and the docs, not the day-to-day process.
.scratch/
docs/agents/
AGENTS.md

# 复制为 .env 后填写真实值。本文件只允许出现占位符，禁止提交真实凭据。

# --- API 运行时 ---
NODE_ENV=development
API_PORT=3000

# --- 数据库（与 compose.dev.yml 对齐）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tiny_blogs
DB_USER=tiny_blogs
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# --- 鉴权 ---
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-48-bytes-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 登录限流：默认 5 次 / 60 秒 / IP。测试里调高以免污染其它用例。
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_MS=60000

# --- 种子管理员（首次启动创建，之后改密用 CLI 脚本）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-12-chars

# --- 构建导出（服务间 token，只存在于构建进程环境，禁止进入前端产物）---
BUILD_EXPORT_TOKEN=change-me-48-bytes-random
BUILD_EXPORT_URL=http://127.0.0.1:3000/api/build/export

# --- 上传 ---
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=5242880

# --- 前端（只有 VITE_ 前缀会进浏览器产物，视同公开）---
VITE_API_BASE=http://127.0.0.1:3000/api
VITE_SITE_URL=http://localhost:5173
# 静态托管子路径：GitHub Pages 项目站点形如 /<repo>/。根路径部署保持默认 /（可留空）。
VITE_SITE_BASE=/tiny-blogs/
# 静态内容模式开关（1 启用）。由 release 脚本与 CI 设置，日常开发不要手动开启；
# 配套的 CONTENT_SNAPSHOT_FILE 由脚本传入，无需在这里配置。
# VITE_STATIC_CONTENT=1
# 页脚的仓库地址；可选，不配则页脚只显示 "GitHub" 字样
VITE_SITE_REPO_URL=
VITE_GISCUS_REPO=
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=
VITE_GISCUS_CATEGORY_ID=

{
  "name": "@tiny-blogs/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 front end for tiny-blogs (SPA + build-time prerender).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:ssg": "vue-tsc --noEmit -p tsconfig.json && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tiny-blogs/shared": "workspace:*",
    "@unhead/vue": "^2.1.17",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.7.2",
    "unhead": "2.1.17",
    "vite": "^6.0.5",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^2.1.10"
  }
}

{
  "name": "@tiny-blogs/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API for tiny-blogs.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.cli.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.cli.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.cli.ts",
    "seed": "ts-node src/scripts/seed-admin.ts",
    "db:reset": "ts-node src/scripts/reset-db.ts && pnpm migration:run && pnpm seed",
    "db:schema": "ts-node src/scripts/inspect-schema.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.2",
    "@tiny-blogs/shared": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@swc/core": "^1.16.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
